# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env (uso local com `netlify dev`) ou
# cadastre cada linha em Netlify › Site configuration ›
# Environment variables.
# NUNCA coloque estes valores dentro do index.html ou do admin.html.
# ═══════════════════════════════════════════════════════════════

# Obrigatória. Mercado Pago › Suas integrações › Credenciais.
# Comece com a de TESTE (TEST-...) e só depois troque pela de
# produção (APP_USR-...).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Recomendada. Assinatura secreta do webhook, gerada na mesma tela
# em que você cadastra a URL de notificação.
MP_WEBHOOK_SECRET=

# Recomendada. Endereço público do seu webhook.
URL_WEBHOOK=https://cabide-imperial.netlify.app/api/webhook

# Opcional. Um webhook do Make, n8n ou Zapier que recebe a venda
# aprovada e dispara o aviso no WhatsApp ou no e-mail da loja.
URL_AVISO=

# Opcional. Trave a API no domínio da loja depois que estiver no ar.
# ORIGEM_PERMITIDA=https://cabideimperial.com.br

# ─── Área da cliente (login e histórico) ───────────────────────

# Obrigatória. String de conexão do Postgres no Neon.
# Neon › seu projeto › Connection string (a que termina em ?sslmode=require)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Obrigatória. Chave que assina os cookies de sessão. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se você trocar esta chave, todas as clientes são deslogadas.
SESSION_SECRET=

# ─── Fotos das peças (Cloudinary) ──────────────────────────────
# As três vêm de cloudinary.com → Dashboard, depois de criar uma
# conta gratuita (25 GB de armazenamento e 25 GB de tráfego/mês).
# A foto vai do navegador direto para lá — nunca passa pela função,
# então não consome os créditos do plano gratuito da Netlify.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
